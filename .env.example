# Tenant developer key from https://www.terminal3.io/claim-page
# Never commit the real value. Shown once at claim time.
T3N_API_KEY=

# Optional: separate agent key from the same claim page.
# An agent DID's credits are separate from the tenant's.
# If unset, the agent scripts authenticate as the tenant and use a self-grant
# (documented in Invoke your TEE contract).
AGENT_KEY=

# Optional: finance-team / data-owner key used to sign agent-auth-update.
# If unset, the tenant key is used for the self-grant path.
USER_KEY=

# Stripe TEST secret only (sk_test_...). Live keys (sk_live_) are rejected.
# Seeded into z:<tid>:secrets inside the TEE — never sent to the model prompt.
STRIPE_SECRET_KEY=

# USD amount that requires a human before execute-payment. Default 500.
APPROVAL_THRESHOLD_USD=500

# Contract semver to register. Must increase on each re-register of the same tail.
CONTRACT_VERSION=0.1.0
